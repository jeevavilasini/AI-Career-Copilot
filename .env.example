# Optional: Adzuna job-search provider (https://developer.adzuna.com/)
# Remotive and Arbeitnow need no credentials and are enabled by default.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Sentence-BERT model used for semantic matching
SBERT_MODEL=all-MiniLM-L6-v2

# Where downloaded models are cached (default: ~/.cache/ai-career-copilot).
# The model is downloaded once, then loaded offline from here on every run.
MODEL_CACHE_DIR=

# HTTP tuning
REQUEST_TIMEOUT=15
